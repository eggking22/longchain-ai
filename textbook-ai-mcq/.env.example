# Copy to .env and fill in real values. Never commit .env.

APP_NAME=textbook-ai-mcq
APP_VERSION=0.1.0
DEBUG=true

# PostgreSQL + pgvector (Phase 0 keeps the interface only, DB not connected yet)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/textbook_mcq

# LLM access (reserved for later phases)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Embedding access (OpenAI-compatible endpoint, default: Zhipu bigmodel).
# EMBEDDING_MODEL=hash switches to the deterministic offline provider (tests/CI).
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=64

# Hybrid retrieval knobs
RETRIEVAL_DENSE_TOP_K=20
RETRIEVAL_SPARSE_TOP_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_MIN_CHUNK_CHARS=10

# Storage locations (relative to project root unless absolute)
UPLOADS_DIR=uploads
ARTIFACTS_DIR=data

# Hierarchical PDF parser knobs
PARSER_MAX_HEADING_LEVELS=4
PARSER_HEADER_FOOTER_BAND=0.09
PARSER_REPEAT_RATIO=0.30
PARSER_CHUNK_TARGET_CHARS=600
PARSER_CHUNK_MAX_CHARS=1200
PARSER_CHUNK_OVERLAP_SENTENCES=1
