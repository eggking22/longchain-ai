# Copy to .env and fill in real values. Never commit .env.

APP_NAME=textbook-ai-mcq
APP_VERSION=0.1.0
DEBUG=true

# PostgreSQL + pgvector (Phase 0 keeps the interface only, DB not connected yet)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/textbook_mcq

# LLM access (reserved for later phases)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Embedding model (reserved for the RAG phase)
EMBEDDING_MODEL=

# Storage locations (relative to project root unless absolute)
UPLOADS_DIR=uploads
ARTIFACTS_DIR=data

# Hierarchical PDF parser knobs
PARSER_MAX_HEADING_LEVELS=4
PARSER_HEADER_FOOTER_BAND=0.09
PARSER_REPEAT_RATIO=0.30
PARSER_CHUNK_TARGET_CHARS=600
PARSER_CHUNK_MAX_CHARS=1200
PARSER_CHUNK_OVERLAP_SENTENCES=1
